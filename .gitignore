# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Caches (rebuildable)
.cache/
.pytest_cache/
.ipynb_checkpoints/

# Local Claude settings (not part of the project)
.claude/

# Data files (source + derived; regenerated by the pipeline)
*.csv
*.jsonl
*.pkl
*.joblib
# Exception: the SofaScore SOT halves dataset is a curated label source
# (27,911 matches, 1H/2H splits) that cannot be regenerated locally.
!data_enrichment/sot_sofascore/sofascore_sot_dataset.csv
# Exception: cup FT actuals extracted from the FotMob store (117 rows,
# grading-ready; the store JSONs themselves stay ignored).
!data_enrichment/cup_actuals.csv
# Exceptions: the combined SOT halves dataset and the FotMob fill outputs
# (labels + remaining-gaps targeting list) — curated data, see
# data_enrichment/HALVES_COVERAGE.md.
!data_enrichment/sot_halves_combined.csv
!data_enrichment/sot_backfill/gap_labels.csv
!data_enrichment/sot_backfill/crossval_labels.csv
!data_enrichment/sot_backfill/remaining_gaps.csv
# The FotMob full-response store (~7,500 matchDetails JSON, GB-scale) is
# local-only bulk data — never commit it. Its index CSV is the committed
# record of what the store holds (see FOTMOB_FULL_COVERAGE.md).
data_enrichment/fotmob_full/
!data_enrichment/fotmob_full_index.csv
# Exception: shot-detail/lineup features materialised from the store —
# the next experiment rounds' starting dataset (regenerating it needs
# the full local store).
!data_enrichment/shot_lineup_features.csv

# Timestamped backups created by pipeline refresh (train data / xG dumps)
*.bak-*

# Runtime ledger state (picks/grades/summary — regenerated)
ledger/
records_cache.meta.json
last_full_pipeline.json
logs/

# Arsip snapshot harian (runtime artifact, bukan source)
archive/

# API-Football raw cache + sample output (rebuildable)
data_enrichment/raw/api_football_cache/
data_enrichment/sample_api_odds.csv

# Tooling / transient runtime artifacts
.playwright-mcp/
ta/session_cookies.json
ta/raw/
data_enrichment/raw/

